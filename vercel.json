{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/rh-upload",
      "destination": "https://www.runninghub.ai/openapi/v2/media/upload/binary"
    },
    {
      "source": "/rh-media/:path*",
      "destination": "https://rh-images-1252422369.cos.ap-beijing.myqcloud.com/:path*"
    },
    {
      "source": "/rh-media-hk/:path*",
      "destination": "https://rh-hk-images-1252422369.cos.ap-hongkong.myqcloud.com/:path*"
    }
  ]
}
